// TASA Website — Prisma Schema
// Prisma 7 · PostgreSQL
// Run: prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  institution   String?
  province      String?
  yearOfStudy   String?
  role          Role        @default(MEMBER)
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rsvps         EventRSVP[]
}

enum Role {
  MEMBER
  BRANCH_LEADER
  ADMIN
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id          String        @id @default(cuid())
  title       String
  date        DateTime
  endDate     DateTime?
  time        String
  location    String
  province    String
  category    EventCategory
  description String
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rsvps       EventRSVP[]
}

enum EventCategory {
  CONFERENCE
  SPIRITUAL
  ACADEMIC
  SOCIAL
  SPORTS
  OUTREACH
}

model EventRSVP {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  name      String
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([eventId, email])
}

// ─── Newsletter ───────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

// ─── Contact ─────────────────────────────────────────────────────────────────

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  department String?
  subject    String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}
